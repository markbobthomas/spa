; Stillwater — a native Godot 3D sandbox, exported with the Compatibility renderer.
config_version=5

[application]
config/name="Stillwater"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A quiet little spa to make your own."

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.75, 0.81, 0.76, 1)

[audio]
driver/enable_input=false

[physics]
common/enable_pause_aware_picking=true
